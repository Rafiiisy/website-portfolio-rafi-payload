# Payload — local dev only (rotate before any real deploy)
# Host-side `npm run dev` / `npm run seed`: use 127.0.0.1 in DATABASE_URI (Mongo port published).
# App in Docker: compose overrides DATABASE_URI to use hostname `mongo`.
DATABASE_URI=mongodb://root:admin123@127.0.0.1:27017/website-portfolio-rafi?authSource=admin
PAYLOAD_SECRET=admin123admin123admin123admin123
SITE_URL=http://localhost:3000

TZ=Asia/Jakarta

DOCKER_PROJECT_NAME=website-portfolio-rafi-payload
DOCKER_PAYLOADCMS_IMAGE=ghcr.io/kesato/website-portfolio-rafi-payload:main
DOCKER_PAYLOADCMS_HOST=Host(`example.com`) || Host(`www.example.com`)
DOCKER_PAYLOADCMS_REDIRECT=redirect-to-non-www

DOCKER_MONGO_DB_VERSION=8-noble
DOCKER_MONGO_DB_USERNAME=root
DOCKER_MONGO_DB_PASSWORD=admin123
DOCKER_MONGO_DB_NAME=website-portfolio-rafi
